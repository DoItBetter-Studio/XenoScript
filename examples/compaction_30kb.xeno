        function compute000(int seed): int {
            int value = seed + 11;
            for (int round = 0; round < 8; round++) {
                value = (value * 3 + round + 11) % 1009;
                value = (value * 5 + 22) % 1013;
                if (value % 3 == 0) {
                    value = (value / 3 + 11) % 997;
                } else {
                    value = (value + round * 7 + 11) % 991;
                }
                value = (value * 7 + round + 11) % 983;
                value = (value + value / 5 + 11) % 977;
            }
            return value;
        }
