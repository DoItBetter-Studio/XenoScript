import <libraries>
import <collections>

@Mod(MyMod.MOD_ID, "1.0.0", "Bogairg")
class MyMod {
	private:
		int myNewInteger;

    public:
		// This comment never get compiled into the xda
        Dictionary<int, string> config = new Dictionary<int, string>();
		
        static final string MOD_ID = "mymod";

        Utils utils = new Utils();

		List<string> myStringList = new List<string>();

        MyMod()
        {
			string ModId = "mymod";
			print("Mod ID set to: " + ModId);

            config.add(0, "Hello, World!");
            config.add(1, "We are alive and well!");

            for (int i = 0; i < config.count(); i++)
            {
                print(config.get(i));
            }

			print(MyMod.MOD_ID);
            print(utils.echo(MyMod.MOD_ID));
        }
}