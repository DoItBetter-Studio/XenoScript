@Mod("fib", "1.0.0", "Tigga")
class Fib
{
    public:
		Fib()
		{
			print(fib(40));
		}

        function fib(int n): int
        {
            if (n <= 0)
            {
                return 0;
            }
            else if (n == 1)
            {
                return 1;
            }
            else
            {
                return fib(n - 1) + fib(n - 2);
            }
        }
}