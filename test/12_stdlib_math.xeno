// Tests: Math stdlib — sqrt, pow, trig, floor/ceil/round, abs, min, max, clamp
import <math>

@Mod("stdlib_math", "1.0.0", "Test")
class StdlibMath {
    public:
        StdlibMath() {
            print(Math.sqrt(4.0));
            print(Math.floor(3.7));
            print(Math.ceil(3.2));
            print(Math.abs(-10));
            print(Math.min(5, 3));
            print(Math.max(5, 3));
            print(Math.clamp(15, 0, 10));
        }
}
