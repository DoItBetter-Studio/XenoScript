// XenoScript Standard Library — Queue<T>
// FIFO structure. Grows automatically — no fixed cap.
// On grow the buffer is linearised (head resets to 0).

/* #Docs
 * # title: Queue
 * # summary: "First-in, first-out queue that grows as needed."
 * # description: "Uses a circular buffer. On grow, elements are linearised and head resets to 0."
 * # since: "1.0.0"
 * #!Docs
 */
class Queue<T> {
    private:
        T[]  data;
        int  head;
        int  tail;
        int  size;
        int  capacity;

    public:
        /* #Docs
         * # title: Queue
         * # summary: "Create an empty queue with a small default capacity."
         * #!Docs
         */
        Queue() {
            capacity = 8;
            data     = new T[8];
            head     = 0;
            tail     = 0;
            size     = 0;
        }

        /* #Docs
         * # title: enqueue
         * # summary: "Add an item at the back of the queue."
         * # param: $item "Element to enqueue."
         * # returns: "void"
         * #!Docs
         */
        function enqueue(T item): void {
            if (size >= capacity) {
                int new_cap = capacity * 2;
                T[] fresh   = new T[new_cap];
                for (int i = 0; i < size; i++) {
                    int src = head + i;
                    if (src >= capacity) { src = src - capacity; }
                    fresh[i] = data[src];
                }
                data     = fresh;
                head     = 0;
                tail     = size;
                capacity = new_cap;
            }
            data[tail] = item;
            tail = tail + 1;
            if (tail >= capacity) { tail = 0; }
            size = size + 1;
        }

        /* #Docs
         * # title: dequeue
         * # summary: "Remove and return the front item."
         * # returns: "The former front element."
         * # note: "On empty queue, prints a message and returns data[0]."
         * #!Docs
         */
        function dequeue(): T {
            if (size <= 0) {
                print("Queue: empty");
                return data[0];
            }
            T item = data[head];
            head = head + 1;
            if (head >= capacity) { head = 0; }
            size = size - 1;
            return item;
        }

        /* #Docs
         * # title: peek
         * # summary: "Return the front item without removing it."
         * # returns: "The current front element."
         * #!Docs
         */
        function peek(): T {
            return data[head];
        }

        /* #Docs
         * # title: count
         * # summary: "Number of items in the queue."
         * # returns: "Element count."
         * #!Docs
         */
        function count(): int {
            return size;
        }

        /* #Docs
         * # title: isEmpty
         * # summary: "True when the queue has no items."
         * # returns: "true if empty."
         * #!Docs
         */
        function isEmpty(): bool {
            return size == 0;
        }

        /* #Docs
         * # title: clear
         * # summary: "Remove all items (capacity unchanged)."
         * # returns: "void"
         * #!Docs
         */
        function clear(): void {
            head = 0;
            tail = 0;
            size = 0;
        }
}