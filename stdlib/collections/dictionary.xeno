// XenoScript Standard Library — Dictionary<K,V>
// A key-value map modelled after C# Dictionary<K,V>.
// Backed by parallel arrays with linear search — suitable for mod use cases.

/* #Docs
 * # title: Dictionary
 * # summary: "A generic key/value map."
 * # description: "Backed by parallel arrays with linear search. Suitable for typical mod-sized collections."
 * # since: "1.0.0"
 * #!Docs
 */
class Dictionary<K, V> {
    private:
        K[]  keys;
        V[]  values;
        int  size;
        int  capacity;

    public:
        /* #Docs
         * # title: Dictionary
         * # summary: "Create an empty dictionary with a small default capacity."
         * #!Docs
         */
        Dictionary() {
            capacity = 8;
            keys     = new K[8];
            values   = new V[8];
            size     = 0;
        }

        /* #Docs
         * # title: add
         * # summary: "Add a new key/value pair."
         * # param: $key "Key to insert. Must not already exist."
         * # param: $value "Value to associate with the key."
         * # returns: "void"
         * # note: "If the key already exists, prints a message and returns without changing the map."
         * #!Docs
         */
        function add(K key, V value): void {
            if (containsKey(key)) {
                print("Dictionary: key already exists");
                return;
            }
            if (size >= capacity) {
                capacity = capacity * 2;
                keys     = __array_grow(keys,   capacity);
                values   = __array_grow(values, capacity);
            }
            keys[size]   = key;
            values[size] = value;
            size = size + 1;
        }

        /* #Docs
         * # title: get
         * # summary: "Return the value for a key."
         * # param: $key "Key to look up."
         * # returns: "The value associated with the key."
         * # note: "If the key is missing, prints a message and returns values[0]."
         * #!Docs
         */
        function get(K key): V {
            for (int i = 0; i < size; i++) {
                if (keys[i] == key) { return values[i]; }
            }
            print("Dictionary: key not found");
            return values[0];
        }

        /* #Docs
         * # title: set
         * # summary: "Set the value for a key, or add it if missing."
         * # param: $key "Key to assign."
         * # param: $value "Value to store."
         * # returns: "void"
         * #!Docs
         */
        function set(K key, V value): void {
            for (int i = 0; i < size; i++) {
                if (keys[i] == key) {
                    values[i] = value;
                    return;
                }
            }
            add(key, value);
        }

        /* #Docs
         * # title: containsKey
         * # summary: "True if the key is present."
         * # param: $key "Key to test."
         * # returns: "true if found, otherwise false."
         * #!Docs
         */
        function containsKey(K key): bool {
            for (int i = 0; i < size; i++) {
                if (keys[i] == key) { return true; }
            }
            return false;
        }

        /* #Docs
         * # title: remove
         * # summary: "Remove a key/value pair."
         * # param: $key "Key to remove."
         * # returns: "void"
         * # note: "No-op if the key does not exist."
         * #!Docs
         */
        function remove(K key): void {
            for (int i = 0; i < size; i++) {
                if (keys[i] == key) {
                    for (int j = i; j < size - 1; j++) {
                        keys[j]   = keys[j + 1];
                        values[j] = values[j + 1];
                    }
                    size = size - 1;
                    return;
                }
            }
        }

        /* #Docs
         * # title: tryGetValue
         * # summary: "Try to read a value without failing when the key is missing."
         * # param: $key "Key to look up."
         * # param: $outValue "Receives the value when found; left unchanged when missing."
         * # returns: "true if the key was found."
         * #!Docs
         */
        function tryGetValue(K key, V outValue): bool {
            for (int i = 0; i < size; i++) {
                if (keys[i] == key) {
                    outValue = values[i];
                    return true;
                }
            }
            return false;
        }

        /* #Docs
         * # title: count
         * # summary: "Number of entries in the dictionary."
         * # returns: "Entry count."
         * #!Docs
         */
        function count(): int {
            return size;
        }

        /* #Docs
         * # title: isEmpty
         * # summary: "True when the dictionary has no entries."
         * # returns: "true if empty."
         * #!Docs
         */
        function isEmpty(): bool {
            return size == 0;
        }

        /* #Docs
         * # title: clear
         * # summary: "Remove all entries."
         * # returns: "void"
         * #!Docs
         */
        function clear(): void {
            size = 0;
        }

        /* #Docs
         * # title: keys
         * # summary: "Return a new array of all keys."
         * # returns: "Array of keys in insertion order."
         * #!Docs
         */
        function keys(): K[] {
            K[] result = new K[size];
            for (int i = 0; i < size; i++) {
                result[i] = keys[i];
            }
            return result;
        }

        /* #Docs
         * # title: values
         * # summary: "Return a new array of all values."
         * # returns: "Array of values aligned with keys()."
         * #!Docs
         */
        function values(): V[] {
            V[] result = new V[size];
            for (int i = 0; i < size; i++) {
                result[i] = values[i];
            }
            return result;
        }
}