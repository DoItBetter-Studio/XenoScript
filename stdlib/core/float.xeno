// XenoScript Standard Library — core/Float
// Constants and type-specific utilities for the float primitive.
// Math operations (abs, min, max, clamp, sqrt, sin, etc.) live in Math.

class Float {
    public:
        // ── Constants ────────────────────────────────────────────────────
        static final float MaxValue    =  3.4028235e38;
        static final float MinValue    = -3.4028235e38;
        static final float Epsilon     =  1.1754944e-38;
        static final float NaN         =  0.0;          // placeholder — host provides real NaN
        static final float PI          =  3.14159265358979323846;
        static final float E           =  2.71828182845904523536;

        // ── Conversions ──────────────────────────────────────────────────
        static function toInt(float n): int {
            return __toInt(n);
        }

        static function toString(float n): string {
            return n as string;
        }

        // ── Float-specific tests ─────────────────────────────────────────
        static function isNear(float a, float b, float epsilon): bool {
            float d = a - b;
            if (d < 0.0) { d = 0.0 - d; }
            return d <= epsilon;
        }
}
