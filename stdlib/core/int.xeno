// XenoScript Standard Library — core/Int
// Constants and type-specific utilities for the int primitive.
// Math operations (abs, min, max, clamp, sign, etc.) live in Math.

class Int {
    public:
        // ── Constants ────────────────────────────────────────────────────
        static final int MaxValue =  2147483647;
        static final int MinValue = -2147483648;

        // ── Conversions ──────────────────────────────────────────────────
        static function toFloat(int n): float {
            return __toFloat(n);
        }

        static function toString(int n): string {
            return n as string;
        }
}